# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
APP_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-separate-random-secret
POSTGRES_PASSWORD=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yoikiji?schema=public

# Razorpay — test keys for local development; never commit real credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Confirm with the seller/tax advisor before enabling checkout
GST_PRICES_INCLUDE_TAX=

# Shipping provider credentials — configure after commercial onboarding
DELHIVERY_API_BASE_URL=https://staging-express.delhivery.com
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
ATS_API_BASE_URL=
ATS_API_KEY=
ATS_ACCOUNT_CODE=
SHIPPING_DEFAULT_PROVIDER=MANUAL
SHIPPING_FLAT_RATE_PAISE=
SHIPPING_TAX_RATE_BPS=

# Seller / pickup information required for live courier booking
SELLER_LEGAL_NAME=
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_STATE_CODE=
SELLER_EMAIL=
SELLER_PHONE=
SELLER_ORIGIN_PIN=
DELHIVERY_PICKUP_WAREHOUSE=


# Transactional email provider (Resend API)
EMAIL_FROM=
EMAIL_API_KEY=

# WhatsApp Cloud API (optional; approved template + customer opt-in required)
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ORDER_TEMPLATE_NAME=
