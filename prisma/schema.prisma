generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum FulfillmentProvider {
  DELHIVERY
  ATS
  MANUAL
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUND_PENDING
  REFUNDED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  QUALITY_ISSUE
  OTHER
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ProductAttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  DATE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  whatsappOptIn Boolean @default(false)
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  addresses    Address[]
  orders       Order[]
  couponRedemptions CouponRedemption[]
  returnRequests ReturnRequest[]
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  fullName    String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  countryCode String   @default("IN")
  isDefault   Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@index([userId])
}

model Category {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?           @db.Text
  imageUrl       String?
  parentId       String?
  sortOrder      Int               @default(0)
  isActive       Boolean           @default(true)
  showInMenu     Boolean           @default(true)
  seoTitle       String?
  seoDescription String?           @db.Text
  parent         Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]        @relation("CategoryTree")
  products       Product[]
  productLinks   ProductCategory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  @@index([parentId, sortOrder, isActive])
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String           @db.Text
  sku             String           @unique
  hsnCode         String?
  material        String?
  color           String?
  careInstructions String?          @db.Text
  weightGrams     Int?
  lengthMm        Int?
  widthMm         Int?
  heightMm        Int?
  pricePaise      Int
  compareAtPaise  Int?
  currency        String           @default("INR")
  gstRateBps      Int              @default(0)
  inventoryQty    Int              @default(0)
  isActive        Boolean          @default(false)
  hasVariants     Boolean          @default(false)
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productTypeId   String?
  productType     ProductType?     @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  categoryLinks   ProductCategory[]
  attributeValues ProductAttributeValue[]
  variants        ProductVariant[]
  images          ProductImage[]
  orderItems      OrderItem[]
  inventoryMovements InventoryMovement[]
  collectionLinks StoreCollectionProduct[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@index([categoryId, isActive])
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  sku             String      @unique
  label           String
  pricePaise      Int?
  compareAtPaise  Int?
  inventoryQty    Int         @default(0)
  isActive        Boolean     @default(true)
  attributes      Json?
  swatchHex       String?
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  images          ProductImage[]
  orderItems      OrderItem[]
  inventoryMovements InventoryMovement[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  @@unique([productId, label])
  @@index([productId, isActive])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  url       String
  alt       String
  position  Int             @default(0)
  isPrimary Boolean         @default(false)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  @@index([productId, variantId, position])
  @@index([productId, isPrimary])
}

model Order {
  id                  String              @id @default(cuid())
  orderNumber         String              @unique
  checkoutKey         String?             @unique
  reservationExpiresAt DateTime?
  userId              String
  status              OrderStatus         @default(PENDING)
  subtotalPaise       Int
  taxPaise            Int
  shippingPaise       Int                 @default(0)
  discountPaise       Int                 @default(0)
  totalPaise          Int
  currency            String              @default("INR")
  shippingAddress     Json
  billingAddress      Json
  fulfillmentProvider FulfillmentProvider?
  fulfillmentOrderId  String?             @unique
  trackingNumber      String?
  trackingUrl         String?
  user                User                @relation(fields: [userId], references: [id])
  items               OrderItem[]
  payment             Payment?
  couponCode          String?
  couponRedemptions   CouponRedemption[]
  returnRequests      ReturnRequest[]
  notifications       NotificationLog[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String
  variantId      String?
  productName    String
  variantLabel   String?
  sku            String
  hsnCode        String?
  quantity       Int
  unitPricePaise Int
  gstRateBps     Int
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  provider              String        @default("RAZORPAY")
  providerOrderId       String?       @unique
  providerPaymentId     String?       @unique
  status                PaymentStatus @default(CREATED)
  amountPaise           Int
  currency              String        @default("INR")
  webhookEventId        String?       @unique
  refundId              String?       @unique
  refundStatus          String?
  refundAmountPaise     Int?
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model InventoryMovement {
  id           String          @id @default(cuid())
  productId    String
  variantId    String?
  quantityDelta Int
  reason       String
  reference    String?
  createdBy    String?
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  @@index([productId, createdAt])
  @@index([variantId, createdAt])
}

model NotificationLog {
  id         String              @id @default(cuid())
  orderId    String
  channel    NotificationChannel
  event      String
  status     NotificationStatus  @default(PENDING)
  providerId String?
  error      String?
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  @@unique([orderId, channel, event])
  @@index([status, createdAt])
}


model ProductType {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  description String?               @db.Text
  products    Product[]
  attributes  ProductTypeAttribute[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model AttributeDefinition {
  id             String                @id @default(cuid())
  name           String
  key            String                @unique
  type           ProductAttributeType
  description    String?               @db.Text
  unit           String?
  options        Json?
  isFilterable   Boolean               @default(false)
  isVariantAxis  Boolean               @default(false)
  isLocalized    Boolean               @default(false)
  isActive       Boolean               @default(true)
  typeLinks      ProductTypeAttribute[]
  values         ProductAttributeValue[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model ProductTypeAttribute {
  id             String              @id @default(cuid())
  productTypeId  String
  attributeId    String
  isRequired     Boolean             @default(false)
  isFilterable   Boolean             @default(false)
  sortOrder      Int                 @default(0)
  productType    ProductType         @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  attribute      AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  @@unique([productTypeId, attributeId])
  @@index([productTypeId, sortOrder])
}

model ProductAttributeValue {
  id          String              @id @default(cuid())
  productId   String
  attributeId String
  value       Json
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  @@unique([productId, attributeId])
  @@index([attributeId])
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([productId, categoryId])
  @@index([categoryId, sortOrder])
}


model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  eyebrow   String?
  title     String?
  body      String?  @db.Text
  imageUrl  String?
  imageAlt  String?
  ctaLabel  String?
  ctaHref   String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive, position])
}

model StoreCollection {
  id          String                  @id @default(cuid())
  name        String
  slug        String                  @unique
  description String?                 @db.Text
  imageUrl    String?
  sortOrder   Int                     @default(0)
  isActive    Boolean                 @default(true)
  products    StoreCollectionProduct[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  @@index([isActive, sortOrder])
}

model StoreCollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int             @default(0)
  collection   StoreCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([collectionId, productId])
  @@index([productId])
}

model Coupon {
  id                    String              @id @default(cuid())
  code                  String              @unique
  description           String?
  discountType          CouponDiscountType
  discountValue         Int
  minimumSubtotalPaise  Int                 @default(0)
  maximumDiscountPaise  Int?
  usageLimit            Int?
  usageCount            Int                 @default(0)
  startsAt              DateTime?
  endsAt                DateTime?
  isActive              Boolean             @default(true)
  redemptions           CouponRedemption[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  @@index([isActive, startsAt, endsAt])
}

model CouponRedemption {
  id           String   @id @default(cuid())
  couponId     String
  orderId      String
  userId       String
  discountPaise Int
  coupon       Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  @@unique([couponId, orderId])
  @@index([userId, createdAt])
}


model ReturnRequest {
  id                 String               @id @default(cuid())
  requestNumber      String               @unique
  orderId            String
  userId             String
  status             ReturnRequestStatus  @default(REQUESTED)
  reason             ReturnReason
  note               String?              @db.Text
  adminNote          String?              @db.Text
  items              Json
  refundAmountPaise  Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  order              Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([orderId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}
